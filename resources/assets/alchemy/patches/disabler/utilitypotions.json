[
  // Use this patch to remove certain utility potions.
  // Turning every potion off is handled by allvariantsoff.json via AnyUtilityPotionEnabled.

  // Coldresist
  {
   "file": "alchemy:itemtypes/liquid/utilitypotionportion.json",
   "op": "addmerge",
   "path": "/skipVariants",
   "value": ["utilitypotionportion-coldresist"],
   "condition": { "when": "AllowColdResistPotion", "isValue": "false" }
  },
  {
   "file": "alchemy:recipes/cooking/utilitypotionportion.json",
   "op": "addmerge",
   "path": "/10/enabled",
   "value": false,
   "condition": { "when": "AllowColdResistPotion", "isValue": "false" }
  },
  {
   "file": "alchemy:recipes/grid/ingredient/coldresistbase.json",
   "op": "addmerge",
   "path": "/enabled",
   "value": false,
   "condition": { "when": "AllowColdResistPotion", "isValue": "false" }
  },
  {
   "file": "alchemy:itemtypes/liquid/utilitypotionportion.json",
   "op": "replace",
   "path": "/attributesByType/*-coldresist/handbook",
   "value": { "exclude": true },
   "condition": { "when": "AllowColdResistPotion", "isValue": "false" }
  },
  {
   "file": "alchemy:itemtypes/ingredient/utilitypotionbase.json",
   "op": "addmerge",
   "path": "/skipVariants",
   "value": ["utilitypotionbase-coldresist"],
   "condition": { "when": "AllowColdResistPotion", "isValue": "false" }
  },

